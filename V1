-- Yardımcı fonksiyon: karakter al
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

-- Teleport (Tween)
local function tweenToCFrame(cf)
    local char = getChar()
    local root = char:WaitForChild("HumanoidRootPart")
    local tweenInfo = TweenInfo.new(1.5, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, tweenInfo, {CFrame = cf})
    tween:Play()
    tween.Completed:Wait()
end

-- Saldırı fonksiyonu (silent, virtual user YOK)
local function attackTarget(target)
    local char = getChar()
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
            local remote = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("Activate")
            if remote then
                remote:FireServer({["MousePos"] = target.HumanoidRootPart.Position})
            end
        end
    end
    local combatRemote = char:FindFirstChild("CombatRemote") or char:FindFirstChild("MeleeRemote")
    if combatRemote then
        combatRemote:FireServer(target)
    end
end

-- Kill Aura döngüsü (normal hızda)
coroutine.wrap(function()
    while task.wait(0.1) do
        if killAura and not fastAttack then  -- fastAttack açıkken kill aura'yı ayrıca kullanma
            local char = getChar()
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then continue end
            local enemies = {}
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= char then
                    local hum = obj:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local hrp = obj:FindFirstChild("HumanoidRootPart")
                        if hrp and (hrp.Position - root.Position).Magnitude <= 50 then
                            table.insert(enemies, obj)
                        end
                    end
                end
            end
            table.sort(enemies, function(a,b)
                return (a.HumanoidRootPart.Position - root.Position).Magnitude < (b.HumanoidRootPart.Position - root.Position).Magnitude
            end)
            if #enemies > 0 then
                attackTarget(enemies[1])
            end
        end
    end
end)()

-- Fast Attack (Auto Click) döngüsü - çok daha hızlı, hedef sürekli saldırı
coroutine.wrap(function()
    while task.wait(0.01) do  -- milisaniyede 1 kez döngü
        if fastAttack then
            local char = getChar()
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then continue end
            -- Kill aura ile aynı hedef seçimi, ama sürekli
            local enemies = {}
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= char then
                    local hum = obj:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local hrp = obj:FindFirstChild("HumanoidRootPart")
                        if hrp and (hrp.Position - root.Position).Magnitude <= 70 then  -- menzil biraz daha geniş
                            table.insert(enemies, obj)
                        end
                    end
                end
            end
            if #enemies > 0 then
                -- En yakın düşmana sürekli saldır
                table.sort(enemies, function(a,b)
                    return (a.HumanoidRootPart.Position - root.Position).Magnitude < (b.HumanoidRootPart.Position - root.Position).Magnitude
                end)
                attackTarget(enemies[1])
            end
        end
    end
end)()

-- Bring Mobs döngüsü (mobları çekme)
coroutine.wrap(function()
    while task.wait(0.1) do
        if bringMobs then
            local char = getChar()
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then continue end
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= char then
                    local hum = obj:FindFirstChild("Humanoid")
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and hrp then
                        hrp.CFrame = root.CFrame * CFrame.new(0,0,5)
                    end
                end
            end
        end
    end
end)()

-- Auto Farm döngüsü (tween + otomatik tüm mekanikleri uygula)
coroutine.wrap(function()
    while task.wait(0.5) do
        if autoFarm then
            local targetPos = farmPositions[selectedFarm]
            if not targetPos then continue end
            tweenToCFrame(targetPos)
            -- Bölgeye vardıktan sonra bekle ve saldırıları başlat (fastAttack veya killAura zaten arkaplanda çalışır)
            task.wait(0.2)
        end
    end
end)()
