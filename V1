-- ==============================================
-- FONKSİYONLAR
-- ==============================================
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

-- Anında teleport (clip - duvarlardan geçer, hız 300+ hissi)
local function instantTeleport(cf)
    local char = getChar()
    local root = char:WaitForChild("HumanoidRootPart")
    root.CFrame = cf -- doğrudan atama, tween yok, hız sınırsız, clip (no-clip) etkisi
end

-- En yakın düşmanı bul (Humanoid ve HumanoidRootPart olan, canlı)
local function getNearestEnemy(range)
    local char = getChar()
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local nearest = nil
    local minDist = range or 70
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= char then
            local hum = obj:FindFirstChild("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= minDist then
                    minDist = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest
end

-- Saldırı yönlendirme ve Redz Fast Attack çağrısı
local function attackNearestEnemy()
    local enemy = getNearestEnemy(70)
    if not enemy then return end
    local char = getChar()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local enemyHRP = enemy:FindFirstChild("HumanoidRootPart")
    if not hrp or not enemyHRP then return end
    
    -- Karakteri düşmana döndür (saldırı yönü için)
    local lookDir = (enemyHRP.Position - hrp.Position).Unit
    hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + lookDir * 10)
    
    -- Redz Fast Attack (CombatFramework kullanarak, VirtualUser YOK)
    pcall(function()
        local CombatFramework = require(LocalPlayer.PlayerScripts.CombatFramework)
        local Controller = CombatFramework.activeController
        if Controller and Controller.blades and Controller.blades[1] then
            Controller.timeToNextAttack = 0   -- Bekleme süresini sıfırla
            Controller.hitboxMagnitude = 60   -- Vuruş menzili geniş
            Controller:attack()               -- Otomatik saldırı (Auto Click)
        end
    end)
end

-- Bring Mobs: 8m içine çek, gerçek moblar, %100 vurulabilir
local function bringMobsToPlayer()
    local char = getChar()
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= char then
            local hum = obj:FindFirstChild("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                -- Sadece 8 metreden uzaktakileri çek, yakınlaştır
                local dist = (hrp.Position - root.Position).Magnitude
                if dist > 8 then
                    -- 8 metre uzağa, oyuncunun baktığı yöne yerleştir
                    local direction = (root.CFrame.LookVector).Unit
                    hrp.CFrame = root.CFrame + direction * 8
                end
            end
        end
    end
end

-- ==============================================
-- ANA DÖNGÜLER (HEARTBEAT İLE)
-- ==============================================
RunService.Heartbeat:Connect(function()
    -- Fast Attack veya Kill Aura açıksa sürekli en yakın düşmana saldır
    if fastAttack or killAura then
        attackNearestEnemy()
    end
end)

-- Bring Mobs döngüsü (daha yavaş çalışır, ama Heartbeat'te de olabilir)
coroutine.wrap(function()
    while task.wait(0.15) do
        if bringMobs then
            bringMobsToPlayer()
        end
    end
end)()

-- Auto Farm: Belirlenen bölgeye ışınlanma ve saldırılar zaten Heartbeat'te sürekli devam eder
coroutine.wrap(function()
    while task.wait(1) do
        if autoFarm then
            local targetPos = farmPositions[selectedFarm]
            if targetPos then
                instantTeleport(targetPos)
            end
        end
    end
end)()
