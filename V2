                if char and char:FindFirstChild("HumanoidRootPart") then
                    local dist = (char.HumanoidRootPart.Position - targetCF.Position).Magnitude
                    if dist > 500 then -- Uzaklaşmışsa resetle
                        if tick() - lastTeleportTime > teleportResetCooldown then
                            char.HumanoidRootPart.CFrame = targetCF
                            lastTeleportTime = tick()
                        end
                    end
                end
            end
        end
    end
end)

