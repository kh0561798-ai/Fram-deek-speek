-- Phần 4: Sea Event sistemi; Tekne Fly/NoClip, Mob Tanıma, Skill Spam

-- Yardımcı: oyuncunun teknesini bul
local function GetPlayerBoat()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("boat") then
            for _, seat in pairs(obj:GetDescendants()) do
                if seat:IsA("Seat") and seat.Occupant == char then
                    return obj
                end
            end
        end
    end
    return nil
end

-- Tekneyi hedef CF'ye tween'le (veya no-clip anında)
local function MoveBoatTo(cf)
    local boat = GetPlayerBoat()
    if not boat then return end
    local primary = boat.PrimaryPart or boat:FindFirstChild("Engine") or boat:FindFirstChild("Main")
    if not primary then return end
    if _G.BoatNoClip then
        -- Anında hareket
        primary.CFrame = cf
    else
        -- Tween ile yumuşak
        local tweenInfo = TweenInfo.new(10 / (_G.BoatSpeed/50), Enum.EasingStyle.Linear)
        local tween = TweenService:Create(primary, tweenInfo, {CFrame = cf})
        tween:Play()
        tween.Completed:Wait()
    end
end

-- Sea mob kontrolü: verilen mob adı listede var mı?
local function IsSeaMobSelected(mobName)
    for _, name in ipairs(_G.SelectedSeaMobs) do
        if mobName:lower():find(name:lower()) then
            return true
        end
    end
    return false
end

-- Skill spam: Melee, Fruit, Gun, Sword
local function SpamSkill(mob)
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        -- Cebindeki uygun aleti kuşan
        local skillType = _G.SelectedSkillType
        for _, t in pairs(LocalPlayer.Backpack:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == skillType then
                char.Humanoid:EquipTool(t)
                tool = t
                break
            end
        end
    end
    if not tool then return end

    -- Remote ile saldırı (melee, fruit vb)
    local remotes = ReplicatedStorage.Remotes
    local remoteName = "Activate_" .. _G.SelectedSkillType -- örn: Activate_Melee
    local activateRemote = remotes:FindFirstChild(remoteName) or remotes:FindFirstChild("Combat")
    if activateRemote then
        pcall(function()
            activateRemote:FireServer({["MousePos"] = mob.HumanoidRootPart.Position})
        end)
    end
end

