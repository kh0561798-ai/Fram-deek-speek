    Btn.TextSize = 13
    Btn.Parent = ParentPage
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
    Btn.MouseButton1Click:Connect(Callback)
end

function AddDropdown(ParentPage, LabelText, Options, Default, Callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -16, 0, 80)
    Frame.BackgroundColor3 = Color3.fromRGB(30,30,50)
    Frame.Parent = ParentPage
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0,6)
    local Lbl = Instance.new("TextLabel", Frame)
    Lbl.Size = UDim2.new(1,0,0,20)
    Lbl.Text = LabelText
    Lbl.TextColor3 = Color3.fromRGB(255,255,255)
    Lbl.BackgroundTransparency = 1
    Lbl.Font = Enum.Font.Gotham
    Lbl.TextSize = 12
    local DropBtn = Instance.new("TextButton", Frame)
    DropBtn.Size = UDim2.new(1,0,0,25)
    DropBtn.Position = UDim2.new(0,0,0,25)
    DropBtn.BackgroundColor3 = Color3.fromRGB(50,50,70)
    DropBtn.Text = Default
    DropBtn.Font = Enum.Font.Gotham
    DropBtn.TextSize = 13
    local List = Instance.new("Frame", Frame)
    List.Size = UDim2.new(1,0,0, #Options*20)
    List.Position = UDim2.new(0,0,0,50)
    List.BackgroundColor3 = Color3.fromRGB(40,40,60)
    List.Visible = false
    for idx, opt in ipairs(Options) do
        local OptBtn = Instance.new("TextButton", List)
        OptBtn.Size = UDim2.new(1,0,0,20)
        OptBtn.Position = UDim2.new(0,0,0, (idx-1)*20)
        OptBtn.Text = opt
        OptBtn.BackgroundColor3 = Color3.fromRGB(60,60,80)
        OptBtn.Font = Enum.Font.Gotham
        OptBtn.TextSize = 12
        OptBtn.TextColor3 = Color3.fromRGB(255,255,255)
        OptBtn.MouseButton1Click:Connect(function()
            DropBtn.Text = opt
            List.Visible = false
            Callback(opt)
        end)
    end
    DropBtn.MouseButton1Click:Connect(function()
        List.Visible = not List.Visible
    end)
    Frame.Size = UDim2.new(1, -16, 0, 50 + #Options*20)
end

