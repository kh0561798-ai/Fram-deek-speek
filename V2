                if #enemies > 0 then
                    -- En yakın düşmana saldır
                    local myPos = (GetPlayerBoat() and GetPlayerBoat():GetPivot().Position) or LocalPlayer.Character.HumanoidRootPart.Position
                    table.sort(enemies, function(a,b) return (a.HumanoidRootPart.Position - myPos).Magnitude < (b.HumanoidRootPart.Position - myPos).Magnitude end)
                    local target = enemies[1]
                    if _G.SelectedSkillType == "Melee" or _G.SelectedSkillType == "Sword" then
                        -- Eğer aura ile vurulabiliyorsa aura kullan, yoksa skill
                        if target.Name:find("Sea Beast") or target.Name:find("Boat") then
                            -- Sea Beast/Boat için skill spam
                            SpamSkill(target)
                        else
                            -- Diğerleri için fast attack (zaten çalışıyorsa)
                            if not _G.FastAttackRedz then
                                _G.FastAttackRedz = true
                                task.wait(0.1)
                                _G.FastAttackRedz = false
                            end
                        end
                    else
                        SpamSkill(target)
                    end
                end
            end)
        end
    end
end)
